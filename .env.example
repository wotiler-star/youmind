# ===== 对外访问端口（自托管时映射到宿主机的端口）=====
PORT=8080

# ===== 后端 AI 配置（可选；不填则 AI 对话走「回显模式」，应用仍可完整运行）=====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/google/gemini-3-pro-preview

# ===== 数据库（默认 SQLite，数据持久化在 docker volume：youmind-data）=====
# 如需使用外部数据库，可改为完整连接串，如 postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:////app/data/youmind.db

# ===== CORS（生产建议改为你的前端域名，逗号分隔）=====
CORS_ALLOW_ORIGINS=*
